<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CoreLibraryPath Condition="'$(CoreLibraryPath)' == ''">../../../src/Lokad.Utf8Regex/bin/Release/net10.0/Lokad.Utf8Regex.dll</CoreLibraryPath>
    <PythonLibraryPath Condition="'$(PythonLibraryPath)' == ''">../../../src/Lokad.Utf8Regex.PythonRe/bin/Release/net10.0/Lokad.Utf8Regex.PythonRe.dll</PythonLibraryPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Lokad.Utf8Regex"><HintPath>$(CoreLibraryPath)</HintPath></Reference>
    <Reference Include="Lokad.Utf8Regex.PythonRe"><HintPath>$(PythonLibraryPath)</HintPath></Reference>
  </ItemGroup>
</Project>
