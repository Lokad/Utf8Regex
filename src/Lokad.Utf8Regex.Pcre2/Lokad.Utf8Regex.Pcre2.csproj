<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Lokad.Utf8Regex.Pcre2</PackageId>
    <Title>Lokad.Utf8Regex.Pcre2</Title>
    <Description>Optional PCRE2 companion package for Lokad.Utf8Regex, providing a UTF-8 oriented PCRE2 API surface without forcing PCRE2 dependencies onto the base library.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>regex;utf8;utf-8;pcre2;span;bytes;performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lokad.Utf8Regex\Lokad.Utf8Regex.csproj" />
  </ItemGroup>

</Project>